{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Workflow",
      "WebSearch",
      "WebFetch",
      "PushNotification",
      "ArtifactData",
      "Bash(python3 factory/scripts/factory.py *)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 *)",
      "Bash(node --test *)",
      "Bash(bash factory/scripts/*)",
      "Bash(npm ci *)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm view *)",
      "Bash(npm outdated *)",
      "Bash(npm audit *)",
      "Bash(npx *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-files *)",
      "Bash(git rev-list *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin HEAD)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git subtree *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git tag *)",
      "Bash(git clone *)",
      "Bash(node *)",
      "Bash(tar *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mktemp *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(date *)",
      "Bash(which *)",
      "Bash(timeout *)",
      "Bash(curl *)",
      "Bash(unzip *)",
      "Bash(zip *)",
      "mcp__github__get_me",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__merge_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__get_label",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__read_documentation",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__list_environments"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * main:main)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push -f *)",
      "Bash(git push * --delete *)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__Gmail__send_message",
      "mcp__Gmail__forward",
      "mcp__Gmail__reply",
      "mcp__OpusClip__opusclip_schedule_publish",
      "mcp__OpusClip__opusclip_create_post_task",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.production.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ArtifactData",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/factory/scripts/factory.py artifact-guard || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/factory/scripts/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
