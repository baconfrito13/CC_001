{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baconfrito13/CC_001/factory/schemas/product.schema.json",
  "title": "Factory product state",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "name",
    "idea",
    "type",
    "status",
    "phase",
    "depth",
    "phases",
    "stack",
    "links",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
    "name": { "type": "string", "minLength": 1 },
    "one_liner": { "type": "string" },
    "idea": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "web-static",
        "web-saas",
        "ai-app",
        "api",
        "mobile",
        "extension",
        "ecommerce",
        "content",
        "bot",
        "desktop",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["active", "needs-founder", "paused", "killed", "launched"]
    },
    "phase": {
      "type": "string",
      "enum": [
        "intake",
        "research",
        "strategy",
        "brand",
        "architecture",
        "build",
        "qa",
        "legal",
        "gtm",
        "launch",
        "growth"
      ]
    },
    "depth": { "type": "string", "enum": ["lean", "standard", "deep"] },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake",
        "research",
        "strategy",
        "brand",
        "architecture",
        "build",
        "qa",
        "legal",
        "gtm",
        "launch",
        "growth"
      ],
      "properties": {
        "intake": { "$ref": "#/$defs/phaseState" },
        "research": { "$ref": "#/$defs/phaseState" },
        "strategy": { "$ref": "#/$defs/phaseState" },
        "brand": { "$ref": "#/$defs/phaseState" },
        "architecture": { "$ref": "#/$defs/phaseState" },
        "build": { "$ref": "#/$defs/phaseState" },
        "qa": { "$ref": "#/$defs/phaseState" },
        "legal": { "$ref": "#/$defs/phaseState" },
        "gtm": { "$ref": "#/$defs/phaseState" },
        "launch": { "$ref": "#/$defs/phaseState" },
        "growth": { "$ref": "#/$defs/phaseState" }
      }
    },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "type": "string", "enum": ["go", "pivot", "kill"] },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "rationale": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_dir"],
      "properties": {
        "recipe": { "type": ["string", "null"] },
        "app_dir": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "components": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "hosting": { "type": ["string", "null"] },
        "payments": { "type": ["string", "null"] },
        "database": { "type": ["string", "null"] },
        "auth": { "type": ["string", "null"] }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": { "type": ["string", "null"] },
        "pr": { "type": ["string", "null"] },
        "issue": { "type": ["string", "null"] },
        "session": { "type": ["string", "null"] },
        "preview": { "type": ["string", "null"] },
        "production": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "repo": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "enum": ["claude", "issue", "inbox", "action", "other"] },
        "ref": { "type": ["string", "null"] }
      }
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "$defs": {
    "phaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "done", "skipped", "blocked"]
        },
        "started": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "completed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "summary": { "type": "string" }
      }
    }
  }
}
