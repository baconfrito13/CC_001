# ---------------------------------------------------------------------------------------
# Environment variables. Copy to .env.local for development; set the same names in the
# hosting provider (Vercel: Project > Settings > Environment Variables) for deployments.
# Every variable is OPTIONAL: the app builds and runs with none of them set.
# NEXT_PUBLIC_* values and the indexing switches are read at BUILD time: change them, then
# redeploy.
# Never commit real values. Only this file (.env.example) is tracked by git.
# ---------------------------------------------------------------------------------------

# ---- Site ----------------------------------------------------------------------------
# Canonical origin of the site, no trailing slash. Used for canonical links, hreflang, the
# sitemap, robots.txt, Open Graph URLs, JSON-LD and Stripe return URLs.
# Where: your production domain. Required for: production (the default is http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# ---- Search-engine indexing (build time) ------------------------------------------------
# Previews and local builds are NOT indexed: robots.txt disallows everything, pages carry
# <meta name="robots" content="noindex"> and an X-Robots-Tag header is sent.
# Indexing is on when VERCEL_ENV=production, or when NEXT_PUBLIC_INDEXABLE=true.
# VERCEL_ENV is set automatically by Vercel; do not set it by hand.
# NEXT_PUBLIC_INDEXABLE=true|false always wins. Use it on Cloudflare or self-hosting, or set
# false to keep a production deployment hidden until launch day.
# Required for: non-Vercel production hosting.
NEXT_PUBLIC_INDEXABLE=
# VERCEL_ENV=

# ---- Analytics (loaded only after consent; Plausible may be cookieless) --------------------
# none | plausible | posthog. Where: decide in the architecture phase.
# Required for: any analytics. Can also be set in src/config/site.ts.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# true = Plausible runs without a cookie banner decision (no cookies, no personal data).
# Ignored for PostHog, which always needs consent.
NEXT_PUBLIC_ANALYTICS_COOKIELESS=
# Plausible: the domain you added in https://plausible.io/sites. Required for: plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible: script URL when self-hosting or proxying. Default https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# PostHog: project API key (starts with phc_), https://eu.posthog.com > Project settings.
# Required for: posthog.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog: API host. Default https://eu.i.posthog.com (EU cloud); US cloud is https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ---- Waitlist (POST /api/waitlist) ------------------------------------------------------
# Chosen automatically: Resend if RESEND_API_KEY is set, else the webhook if
# WAITLIST_WEBHOOK_URL is set, else "console" in development/test. In production with nothing
# configured the API answers 503 and logs an error.
# Force one adapter: console | resend | webhook. "console" logs the e-mail address: use it for
# local development and tests only.
WAITLIST_ADAPTER=
# Resend API key, https://resend.com/api-keys (needs "Full access" to manage contacts).
# Required for: the resend adapter.
RESEND_API_KEY=
# Resend segment (formerly "audience") that receives the contacts, https://resend.com/audiences
# Optional: without it, contacts are created without a segment.
RESEND_SEGMENT_ID=
# Any HTTPS endpoint (Zapier, Make, n8n, your own API). Receives POST JSON:
# { "email", "locale", "consentAt", "source" }. Required for: the webhook adapter.
WAITLIST_WEBHOOK_URL=

# ---- Payments ---------------------------------------------------------------------------
# No-code alternative that needs none of these: set `checkoutUrl` on a plan in
# src/config/site.ts (Lemon Squeezy, Paddle, Polar, a Stripe Payment Link).
#
# Stripe secret key, https://dashboard.stripe.com/apikeys (use sk_test_... until go-live).
# Required for: POST /api/checkout and the webhook (plans with `stripePriceId`).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Create an endpoint pointing at
# https://<your-domain>/api/webhooks/stripe for checkout.session.completed and
# customer.subscription.created|updated|deleted at https://dashboard.stripe.com/webhooks
# (locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`).
# Required for: POST /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# ---- Tests only (not read by the app) ---------------------------------------------------
# CHROMIUM_PATH=/path/to/chromium   use a preinstalled browser for `npm run test:e2e`
# BASE_URL=https://my-product.example   run `npm run test:smoke` against a deployed site
