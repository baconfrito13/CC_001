# ---------------------------------------------------------------------------------------
# Environment variables. Copy to .env.local for development; set the same names in the
# hosting provider (Vercel: Project > Settings > Environment Variables) for deployments.
# Every variable is OPTIONAL: the app builds and runs with none of them set.
# NEXT_PUBLIC_* values and the indexing switches are read at BUILD time: change them, then
# redeploy.
# Never commit real values. Only this file (.env.example) is tracked by git.
# ---------------------------------------------------------------------------------------

# ---- Site ----------------------------------------------------------------------------
# Canonical origin of the site, no trailing slash. Used for canonical links, hreflang, the
# sitemap, robots.txt, Open Graph URLs, JSON-LD and Stripe return URLs.
# Where: your production domain. Required for: production (the default is http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# ---- Search-engine indexing (build time) ------------------------------------------------
# Previews and local builds are NOT indexed: robots.txt disallows everything, pages carry
# <meta name="robots" content="noindex"> and an X-Robots-Tag header is sent.
# Indexing is on when VERCEL_ENV=production, or when NEXT_PUBLIC_INDEXABLE=true.
# VERCEL_ENV is set automatically by Vercel; do not set it by hand.
# NEXT_PUBLIC_INDEXABLE=true|false always wins. Use it on Cloudflare or self-hosting, or set
# false to keep a production deployment hidden until launch day.
# Required for: non-Vercel production hosting.
NEXT_PUBLIC_INDEXABLE=
# VERCEL_ENV=

# ---- Analytics (loaded only after consent; Plausible may be cookieless) --------------------
# none | plausible | posthog. Where: decide in the architecture phase.
# Required for: any analytics. Can also be set in src/config/site.ts.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# true = Plausible runs without a cookie banner decision (no cookies, no personal data).
# Ignored for PostHog, which always needs consent.
NEXT_PUBLIC_ANALYTICS_COOKIELESS=
# Plausible: the domain you added in https://plausible.io/sites. Required for: plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible: script URL when self-hosting or proxying. Default https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# PostHog: project API key (starts with phc_), https://eu.posthog.com > Project settings.
# Required for: posthog.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog: API host. Default https://eu.i.posthog.com (EU cloud); US cloud is https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ---- Waitlist (POST /api/waitlist) ------------------------------------------------------
# Chosen automatically: Resend if RESEND_API_KEY is set, else the webhook if
# WAITLIST_WEBHOOK_URL is set, else "console" in development/test. In production with nothing
# configured the API answers 503 and logs an error.
# Force one adapter: console | resend | webhook. "console" logs the e-mail address: use it for
# local development and tests only.
WAITLIST_ADAPTER=
# Resend API key, https://resend.com/api-keys (needs "Full access" to manage contacts).
# Required for: the resend adapter.
RESEND_API_KEY=
# Resend segment (formerly "audience") that receives the contacts, https://resend.com/audiences
# Optional: without it, contacts are created without a segment.
RESEND_SEGMENT_ID=
# Any HTTPS endpoint (Zapier, Make, n8n, your own API). Receives POST JSON:
# { "email", "locale", "consentAt", "source" }. Required for: the webhook adapter.
WAITLIST_WEBHOOK_URL=

# ---- Online withdrawal function (POST /api/withdrawal, /<locale>/withdraw) ------------------
# Only exists when legal.sellsToConsumers is true (EU Directive 2023/2673, Art. 11a of
# Directive 2011/83/EU: consumers must be able to withdraw online and get an acknowledgement).
# Uses the same adapter choice as the waitlist (WAITLIST_ADAPTER / RESEND_API_KEY / webhook).
# In production without an adapter it answers 503 and logs an error.
# Resend: sender of the acknowledgement e-mail and notification, on a domain verified at
# https://resend.com/domains, e.g. "Rastoplan <nao-responder@rastoplan.com>". Required for: the resend adapter.
# The notification goes to contact.supportEmail (src/config/site.ts).
RESEND_FROM=
# Webhook for withdrawals only (e.g. your support desk). Falls back to WAITLIST_WEBHOOK_URL.
# Receives { "type": "withdrawal", name, email, reference, message, locale, submittedAt, source,
# acknowledgement: { subject, text } }: the receiving automation must e-mail the acknowledgement.
WITHDRAWAL_WEBHOOK_URL=

# ---- Payments ---------------------------------------------------------------------------
# No-code alternative that needs none of these: set `checkoutUrl` on a plan in
# src/config/site.ts (Lemon Squeezy, Paddle, Polar, a Stripe Payment Link).
#
# Stripe secret key, https://dashboard.stripe.com/apikeys (use sk_test_... until go-live).
# Required for: POST /api/checkout and the webhook (plans with `stripePriceId`).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Create an endpoint pointing at
# https://<your-domain>/api/webhooks/stripe for checkout.session.completed and
# customer.subscription.created|updated|deleted at https://dashboard.stripe.com/webhooks
# (locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`).
# Required for: POST /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# ---- Adapters: test mode is the default (S-01) ---------------------------------------------
# Every capability that needs a founder account sits behind an adapter. With none of these set
# the app runs entirely in test mode: data and files in memory, simulated sign-in and payments,
# email printed to the log. In PRODUCTION the server REFUSES TO BOOT while any test adapter is
# active (memory / mock / console), see src/lib/env.ts. Values below are shown commented out
# with their default.
#
# Where the data lives: memory | supabase. Required for supabase: the three SUPABASE_* values.
# DATA_ADAPTER=memory
# Where PDFs and geometry packages live: memory | supabase (private buckets).
# STORAGE_ADAPTER=memory
# Who signs people in: mock | supabase (implemented with US-01, slice S-03).
# AUTH_ADAPTER=mock
# Transactional email: console | resend. Required for resend: RESEND_API_KEY and EMAIL_FROM.
# EMAIL_ADAPTER=console
# Payments: mock | stripe (implemented with US-08/US-12, slice S-07). Required for stripe:
# STRIPE_SECRET_KEY.
# PAYMENTS_ADAPTER=mock
# Real money. Must stay false until the founder tasks for Stripe and the tax regime are done.
# true needs PAYMENTS_ADAPTER=stripe, an sk_live_ key and STRIPE_WEBHOOK_SECRET; a live key
# with PAYMENTS_LIVE not true is refused too, so a preview can never charge a card.
# PAYMENTS_LIVE=false
# Where sheet processing runs: inline (inside the request, development) | after (production).
# PROCESSING_MODE=inline
# CI and local production builds ONLY. `next start` always sets NODE_ENV=production, so the
# e2e suite sets this to true to boot with the test adapters. It is ignored (and reported as
# an error) when VERCEL_ENV=production. Never set it on a real deployment.
# ALLOW_TEST_ADAPTERS=false

# ---- Supabase (https://supabase.com/dashboard, region Central EU / Frankfurt) --------------
# Project URL and anon key: Project settings > API. Both are public by design: Row Level
# Security protects the data. Required for: any *_ADAPTER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET, server only, never a NEXT_PUBLIC_ variable): bypasses RLS. The app
# imports it only in modules marked `server-only`. Confirm the current name of this key in the
# dashboard (Supabase has been renaming API keys). Required for: any *_ADAPTER=supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (EMAIL_ADAPTER=resend) -------------------------------------------------------------
# Sender on a domain verified at https://resend.com/domains, e.g.
# "Rastoplan <nao-responder@rastoplan.com>". RESEND_FROM (above) is accepted as a fallback so
# the sender is configured once. Required for: EMAIL_ADAPTER=resend.
EMAIL_FROM=

# ---- Secrets generated per environment (openssl rand -hex 32) ---------------------------------
# Bearer token for /api/internal/* and /api/cron/* (32+ characters). Required for: production.
CRON_SECRET=
# Salt for the keyed hashes used in logs, rate limits and login attempts (16+ characters). It
# is what stops a leaked table or log line being traced back to a person. Required for: production.
HASH_SALT=

# ---- Monitoring ---------------------------------------------------------------------------
# Sentry project DSN (https://sentry.io, EU data residency). Its origin is allowed in the CSP
# connect-src; error reporting arrives in slice S-08. Optional.
SENTRY_DSN=

# ---- Product limits (PRD section 7 and US-08): the defaults are the product rules -------------
# MAX_PDF_MB=50                  largest PDF accepted (upload goes straight to storage)
# MAX_PDF_PAGES=40               most pages (sheets) per PDF
# PROCESSING_MAX_ELEMENTS=500000 vector elements one sheet may have before it is refused
# LOW_DIVERSITY_SHARE=0.9        share of elements in one style that warns "low style diversity"
# TRIAL_SHEETS=5                 sheets in the free trial
# TRIAL_DAYS=14                  days the trial sheets stay valid
# LOT_VALIDITY_DAYS=90           days a purchased lot of sheets stays valid
# GRACE_DAYS=7                   days of access after a failed subscription payment
# FOUNDER_PRICE_SLOTS=10         subscriptions that get the founder price
# UPLOADS_PER_HOUR=30            PDF uploads per user per hour

# ---- Tests only (not read by the app) ---------------------------------------------------
# CHROMIUM_PATH=/path/to/chromium   use a preinstalled browser for `npm run test:e2e`
# BASE_URL=https://my-product.example   run `npm run test:smoke` against a deployed site
# PG_TEST_URL=postgresql://postgres@127.0.0.1:54329/postgres   a throwaway Postgres 16 for
#   `npm run test:pg` (the SQL suites with real parallel connections); see README, Tests
